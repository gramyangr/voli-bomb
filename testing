local function sendWebhook(title, description, colorHex)
	if not httpRequest then
		return false, "Executor tidak support HTTP"
	end
	local url = (cfg.webhookUrl or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if url == "" or not url:find("^https://") then
		return false, "URL Webhook tidak valid"
	end
	local payload = {
		username = "Gremy Hub Notifier",
		embeds = {{
			title = title,
			description = description,
			color = colorHex or 15844367,
			footer = {
				text = "GREMY • " .. LocalPlayer.Name .. " • " .. os.date("%H:%M:%S"),
			},
		}},
	}
	local ok, res = pcall(function()
		return httpRequest({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
	end)
	if ok and res and (res.StatusCode == 200 or res.StatusCode == 204) then
		return true, "Terkirim!"
	end
	return false, "Gagal mengirim webhook"
end

