local function hasAnyKeyword(str, keywords)
	if not str or str == "" then
		return false
	end
	for _, kw in ipairs(keywords) do
		if str:find(kw, 1, true) then
			return true
		end
	end
	return false
end

local function cleanDishName(str)
	if not str or str == "" then
		return ""
	end
	local s = str:lower()
	s = s:gsub("%s+lv%.?%s*%d+", "")
	s = s:gsub("^%s+", ""):gsub("%s+$", "")
	return s
end

local function getHRP()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function safeTeleport(cf)
	local hrp = getHRP()
	local hum = getHumanoid()
	if not hrp or not cf then
		return
	end
	if hum and hum.Sit then
		hum.Sit = false
		task.wait(0.05)
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.CFrame = cf
end

local function tpToPart(part, offset)
	local hrp = getHRP()
	if not hrp or not part or not part.Parent then
		return false
	end
	local ok, pos = pcall(function()
		return part:IsA("Model") and part:GetPivot().Position or part.Position
	end)
	if not ok or not pos then
		return false
	end
	safeTeleport(CFrame.new(pos + (offset or Vector3.new(0, 2, 2.2))))
	return true
end

local function triggerPromptSafe(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end
	if fireproximityprompt then
		pcall(function()
			fireproximityprompt(prompt)
		end)
	else
		pcall(function()
			prompt:InputHoldBegin()
		end)
		task.wait((prompt.HoldDuration or 0) + 0.1)
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end
	return true
end

