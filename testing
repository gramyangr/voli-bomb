	Btn.Position = UDim2.new(0, 8, 0.5, -24)
	Btn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	Btn.BackgroundTransparency = 0.1
	Btn.Text = "G"
	Btn.TextColor3 = Color3.fromRGB(220, 224, 235)
	Btn.TextSize = 20
	Btn.Font = Enum.Font.GothamBold
	Btn.AutoButtonColor = false
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 14)

	local stroke = Instance.new("UIStroke", Btn)
	stroke.Color = Color3.fromRGB(190, 198, 215)
	stroke.Thickness = 1.8

	local isDragging, startTouch, startBtnPos, touchActive = false, Vector2.zero, UDim2.new(), false

	Btn.InputBegan:Connect(function(inp)
		if inp.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		touchActive = true
		isDragging = false
		startTouch = Vector2.new(inp.Position.X, inp.Position.Y)
		startBtnPos = Btn.Position

		inp:GetPropertyChangedSignal("Delta"):Connect(function()
			if not touchActive then
				return
			end
			local delta = Vector2.new(inp.Position.X, inp.Position.Y) - startTouch
			if delta.Magnitude > 10 then
				isDragging = true
				Btn.Position = UDim2.new(
					startBtnPos.X.Scale,
					startBtnPos.X.Offset + delta.X,
					startBtnPos.Y.Scale,
					startBtnPos.Y.Offset + delta.Y
				)
			end
		end)
	end)

	Btn.InputEnded:Connect(function(inp)
		if inp.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		touchActive = false
		if not isDragging then
			pcall(function()
				Window:Minimize()
			end)
		end
		isDragging = false
	end)
end

