local function getActivePrompts()
	local list = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled then
			local part = obj.Parent
			if part and part:IsA("Attachment") then
				part = part.Parent
			end
			if part and part.Parent and (part:IsA("BasePart") or part:IsA("Model")) then
				local parentChain = ""
				pcall(function()
					parentChain = obj:GetFullName():lower()
				end)
				table.insert(list, {
					prompt = obj,
					part = part,
					fullName = parentChain,
					act = (obj.ActionText or ""):lower(),
					objTxt = (obj.ObjectText or ""):lower(),
					cleanObj = cleanDishName(obj.ObjectText or ""),
					rawObj = obj.ObjectText or "",
				})
			end
		end
	end
	return list
end

local function classifyPrompts(prompts)
	local out = {
		orders = {},
		customers = {},
		takeStations = {},
		cookStations = {},
		deliveryRack = nil,
	}
	for _, p in ipairs(prompts) do
		if hasAnyKeyword(p.act, { "ambil pesanan", "pesanan", "take order", "order" }) then
			table.insert(out.orders, p)
		elseif hasAnyKeyword(p.act, { "antar makanan", "antar", "serve", "deliver", "give" }) then
			table.insert(out.customers, p)
		elseif p.act == "ambil" or p.act == "take" or p.act == "pick up" or p.act == "grab" then
			table.insert(out.takeStations, p)
		elseif hasAnyKeyword(p.act, { "masak", "cook", "make", "prepare", "brew" }) then
			table.insert(out.cookStations, p)
		elseif hasAnyKeyword(p.act, { "taruh di rak", "place on rack", "put on rack", "rack" }) or hasAnyKeyword(p.objTxt, { "loket delivery", "delivery counter", "delivery rack" }) then
			out.deliveryRack = p
		end
	end
	return out
end

local function stationMatchesOrder(stationObjTxt, orderObjTxt)
	local s = cleanDishName(stationObjTxt)
	local o = cleanDishName(orderObjTxt)
	if s == "" or o == "" then
		return false
	end
	if hasAnyKeyword(o, { "teh", "tea", "es ", "ice", "minum", "drink", "jus", "juice", "kopi", "coffee", "congklak", "layangan", "gasing" }) then
		return hasAnyKeyword(s, { "dispenser", "es", "ice", "minum", "drink" })
	end
	if hasAnyKeyword(o, { "mie", "noodle", "gadoan", "engklek", "bentengan", "bakmi", "ramen" }) then
		return hasAnyKeyword(s, { "kompor", "stove", "mie", "noodle", "cooker" })
	end
	if hasAnyKeyword(o, { "dimsum", "kukus", "steam", "siomay", "lumpia", "udang", "shrimp", "pangsit", "dumpling", "wonton" }) then
		return hasAnyKeyword(s, { "kukus", "steam", "dimsum" })
	end
	for word in o:gmatch("%a+") do
		if #word >= 3 and word ~= "lv" and s:find(word, 1, true) then
			return true
		end
	end
	return false
end

local function itemMatchesText(aTxt, bTxt)
	local a = cleanDishName(aTxt)
	local b = cleanDishName(bTxt)
	if a == "" or b == "" then
		return false
	end
	if a:find(b, 1, true) or b:find(a, 1, true) then
		return true
	end
	for word in b:gmatch("%a+") do
		if #word >= 3 and word ~= "lv" and a:find(word, 1, true) then
			return true
		end
	end
	return false
end

-- ─── FUNGSI ANTAR PESANAN (MANDIRI) ───────────────────────────────
local function deliverHeldItem(customers, deliveryRack, allowRackFallback)
	local now = os.clock()
	local hlTarget = findHighlightedPrompt()
	if hlTarget and hlTarget.prompt and hlTarget.part then
		if tpToPart(hlTarget.part, Vector3.new(0, 2, 2.5)) then
			task.wait(cfg.serveDelay)
			triggerPromptSafe(hlTarget.prompt)
			statsServed = statsServed + 1
			task.wait((hlTarget.prompt.HoldDuration or 0) + cfg.serveDelay)
			return true
		end
	end

	local hand = getHandStatusFromUI()
	if hand and hand.isOnline and deliveryRack then
		if tpToPart(deliveryRack.part, Vector3.new(0, 2, 2.5)) then
			task.wait(cfg.serveDelay)
			triggerPromptSafe(deliveryRack.prompt)
			statsServed = statsServed + 1
			task.wait((deliveryRack.prompt.HoldDuration or 0) + cfg.serveDelay)
			return true
		end
	end

	if hand and hand.targetDest ~= "" then
		local destClean = cleanDishName(hand.targetDest)
		for _, cust in ipairs(customers) do
			if cust.fullName:find(hand.targetDest, 1, true)
				or cust.objTxt:find(hand.targetDest, 1, true)
				or (destClean ~= "" and (cust.fullName:find(destClean, 1, true) or cust.cleanObj:find(destClean, 1, true)))
			then
				if (now - (lastCustomerTry[cust.prompt] or 0)) >= 1.2 then
					lastCustomerTry[cust.prompt] = now
					if tpToPart(cust.part, Vector3.new(0, 2, 2.5)) then
						task.wait(cfg.serveDelay)
						triggerPromptSafe(cust.prompt)
						statsServed = statsServed + 1
						task.wait((cust.prompt.HoldDuration or 0) + cfg.serveDelay)
						return true
					end
				end
			end
		end
	end

	for _, cust in ipairs(customers) do
		if (not hand or hand.itemName == "" or itemMatchesText(cust.cleanObj, hand.itemName)) and (now - (lastCustomerTry[cust.prompt] or 0)) >= 1.5 then
			lastCustomerTry[cust.prompt] = now
			if tpToPart(cust.part, Vector3.new(0, 2, 2.5)) then
				task.wait(cfg.serveDelay)
				triggerPromptSafe(cust.prompt)
				statsServed = statsServed + 1
				task.wait((cust.prompt.HoldDuration or 0) + cfg.serveDelay)
				return true
			end
		end
	end

	if allowRackFallback and deliveryRack then
		if tpToPart(deliveryRack.part, Vector3.new(0, 2, 2.5)) then
			task.wait(cfg.serveDelay)
			triggerPromptSafe(deliveryRack.prompt)
			statsServed = statsServed + 1
			task.wait((deliveryRack.prompt.HoldDuration or 0) + cfg.serveDelay)
			return true
		end
	end

	return false
end

local function runAutoServeStep()
	local data = classifyPrompts(getActivePrompts())
	local hrp = getHRP()
	if not hrp then
		return
	end
	local hand = getHandStatusFromUI()
	if hand and hand.holding then
		local origCFrame = hrp.CFrame
		deliverHeldItem(data.customers, data.deliveryRack, cfg.autoDeliveryRack)
		safeTeleport(origCFrame)
		return
	end

	if #data.takeStations > 0 then
		local chosenTake = nil
		for _, take in ipairs(data.takeStations) do
			for _, cust in ipairs(data.customers) do
				if itemMatchesText(take.cleanObj, cust.cleanObj) then
					chosenTake = take
					break
				end
			end
			if chosenTake then
				break
			end
		end
		if chosenTake then
			local origCFrame = hrp.CFrame
			if tpToPart(chosenTake.part, Vector3.new(0, 2, 2)) then
				task.wait(cfg.serveDelay)
				triggerPromptSafe(chosenTake.prompt)
				task.wait((chosenTake.prompt.HoldDuration or 0) + 0.15)
				deliverHeldItem(data.customers, data.deliveryRack, cfg.autoDeliveryRack)
			end
			safeTeleport(origCFrame)
		end
	end
end

-- ─── AUTO AMBIL PESANAN (MANDIRI) ────────────────────────────────
local function runAutoTakeOrderStep()
	local data = classifyPrompts(getActivePrompts())
	if #data.orders == 0 then
		return
	end
	local hrp = getHRP()
	if not hrp then
		return
	end
	local now = os.clock()
	for _, ord in ipairs(data.orders) do
		if (now - (lastOrderTry[ord.prompt] or 0)) >= 1.2 then
			lastOrderTry[ord.prompt] = now
			local origCFrame = hrp.CFrame
			if tpToPart(ord.part, Vector3.new(0, 2, 2.5)) then
				task.wait(cfg.serveDelay)
				triggerPromptSafe(ord.prompt)
				task.wait((ord.prompt.HoldDuration or 0) + cfg.serveDelay)
			end
			safeTeleport(origCFrame)
			return
		end
	end
end

-- ─── AUTO MASAK (MANDIRI) ────────────────────────────────────────
local function runAutoCookStep()
	local data = classifyPrompts(getActivePrompts())
	if #data.cookStations == 0 then
		return
	end
	local hrp = getHRP()
	if not hrp then
		return
	end
	local now = os.clock()
	local targetCook = nil

	for _, cust in ipairs(data.customers) do
		for _, cook in ipairs(data.cookStations) do
			if stationMatchesOrder(cook.objTxt, cust.objTxt) and (now - (lastCookAttempt[cook.prompt] or 0)) >= 1.2 then
				targetCook = cook
				break
			end
		end
		if targetCook then
			break
		end
	end

	if not targetCook then
		for _, cook in ipairs(data.cookStations) do
			if (now - (lastCookAttempt[cook.prompt] or 0)) >= 1.5 then
				targetCook = cook
				break
			end
		end
	end

	if targetCook then
		lastCookAttempt[targetCook.prompt] = now
		local origCFrame = hrp.CFrame
		if tpToPart(targetCook.part, Vector3.new(0, 2, 2)) then
			task.wait(cfg.serveDelay)
			triggerPromptSafe(targetCook.prompt)
			task.wait((targetCook.prompt.HoldDuration or 0) + cfg.cookWait)
			if cfg.autoServeEnabled or cfg.autoDeliveryRack then
				local handAfterCook = getHandStatusFromUI()
				if (handAfterCook and handAfterCook.holding) or findHighlightedPrompt() then
					local fresh = classifyPrompts(getActivePrompts())
					deliverHeldItem(fresh.customers, fresh.deliveryRack or data.deliveryRack, cfg.autoDeliveryRack)
				end
			end
		end
		safeTeleport(origCFrame)
	end
end

-- ─── AUTO DELIVERY ONLINE (MANDIRI) ──────────────────────────────
local function runAutoDeliveryStep()
	local data = classifyPrompts(getActivePrompts())
	if not data.deliveryRack then
		return
	end
	local hrp = getHRP()
	if not hrp then
		return
	end
	local hand = getHandStatusFromUI()
	local hl = findHighlightedPrompt()
	if (hand and (hand.holding or hand.isOnline)) or hl or #data.takeStations > 0 then
		local origCFrame = hrp.CFrame
		if #data.takeStations > 0 and not (hand and hand.holding) then
			if tpToPart(data.takeStations[1].part, Vector3.new(0, 2, 2)) then
				task.wait(cfg.serveDelay)
				triggerPromptSafe(data.takeStations[1].prompt)
				task.wait((data.takeStations[1].prompt.HoldDuration or 0) + 0.15)
			end
		end
		if tpToPart(data.deliveryRack.part, Vector3.new(0, 2, 2.5)) then
			task.wait(cfg.serveDelay)
			triggerPromptSafe(data.deliveryRack.prompt)
			statsServed = statsServed + 1
			task.wait((data.deliveryRack.prompt.HoldDuration or 0) + cfg.serveDelay)
		end
		safeTeleport(origCFrame)
	end
end

-- ─── AUTO BERSIH MEJA (MANDIRI) ──────────────────────────────────
local function runAutoCleanStep()
	local prompts = getActivePrompts()
	local dirtyList = {}
	for _, p in ipairs(prompts) do
		if hasAnyKeyword(p.act, { "bersihkan", "bersih", "clean", "wipe", "clear" }) then
			table.insert(dirtyList, p)
		end
	end
	if #dirtyList == 0 then
		return
	end
	local hrp = getHRP()
	if not hrp then
		return
	end
	local origCFrame = hrp.CFrame
	for _, item in ipairs(dirtyList) do
		if not cfg.autoCleanEnabled then
			break
		end
		actBusyStart = os.clock()
		if item.prompt and item.prompt.Parent and item.prompt.Enabled then
			if tpToPart(item.part, Vector3.new(0, 2, 2)) then
				task.wait(cfg.serveDelay)
				triggerPromptSafe(item.prompt)
				statsCleaned = statsCleaned + 1
				task.wait((item.prompt.HoldDuration or 0) + cfg.serveDelay)
			end
		end
	end
	safeTeleport(origCFrame)
end

