	if cfg.autoUnlockDish and #CatalogDishes > 0 then
		local dId = CatalogDishes[dishCursor]
		if dId then
			invokeBuy("dish", dId)
			invokeBuy("menu", dId)
		end
		dishCursor = (dishCursor % #CatalogDishes) + 1
	end
	if cfg.autoBuyItems and #CatalogItems > 0 then
		local entry = CatalogItems[itemCursor]
		if entry then
			invokeBuy("item", entry.id)
		end
		itemCursor = (itemCursor % #CatalogItems) + 1
	end
	if cfg.autoBuyStaff and #CatalogStaff > 0 then
		local sId = CatalogStaff[staffCursor]
		if sId then
			invokeBuy("staff", sId)
		end
		staffCursor = (staffCursor % #CatalogStaff) + 1
	end
end

