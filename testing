local function processAutoQuest()
	if ClaimQuestRemote and ClaimQuestRemote:IsA("RemoteFunction") then
		local ok, res = pcall(function()
			return ClaimQuestRemote:InvokeServer()
		end)
		if ok and res ~= false then
			statsQuests = statsQuests + 1
			notify("Gremy Hub • Quest", "Hadiah quest berhasil diklaim!", 3)
			if cfg.webhookEnabled then
				task.spawn(sendWebhook, "Quest Claimed", "Berhasil klaim quest otomatis!", 5763719)
			end
		end
	end
end

