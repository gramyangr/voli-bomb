-- ─── DETEKSI TARGET HIGHLIGHT DI WORKSPACE (ID + EN) ──────────────
local function findHighlightedPrompt()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if (obj:IsA("Highlight") and obj.Enabled) or (obj:IsA("SelectionBox") and obj.Visible) then
			local target = (obj:IsA("Highlight") and obj.Adornee) or (obj:IsA("SelectionBox") and obj.Adornee) or obj.Parent
			if target and target.Parent then
				local searchRoot = target
				if searchRoot.Parent and searchRoot.Parent:IsA("Model") and searchRoot.Parent ~= workspace then
					searchRoot = searchRoot.Parent
				end
				for _, sub in ipairs(searchRoot:GetDescendants()) do
					if sub:IsA("ProximityPrompt") and sub.Enabled then
						local act = (sub.ActionText or ""):lower()
						if hasAnyKeyword(act, { "antar", "taruh", "serah", "serve", "deliver", "place", "put", "drop", "give" }) then
							local part = sub.Parent
							if part and part:IsA("Attachment") then
								part = part.Parent
							end
							if part and part.Parent then
								return { prompt = sub, part = part }
							end
						end
					end
				end
			end
		end
	end
	return nil
end

-- ─── DETEKSI STATUS TANGAN & TUJUAN PERSIS DARI UI & KARAKTER ─────
local function getHandStatusFromUI()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		for _, obj in ipairs(pg:GetDescendants()) do
			if obj:IsA("TextLabel") and obj.Visible then
				local raw = obj.Text or ""
				local clean = raw:gsub("<[^>]+>", ""):gsub("%s+", " ")
				local low = clean:lower()
				if hasAnyKeyword(low, { "membawa:", "carrying:", "holding:" }) then
					local isOnline = hasAnyKeyword(low, { "delivery", "online", "loket", "rak", "rack", "counter", "antar #", "deliver #" }) or (low:find("#%d+") ~= nil)
					local targetDest = low:match("→%s*(.+)$") or low:match("%-%>%s*(.+)$") or ""
					targetDest = targetDest:gsub("^%s+", ""):gsub("%s+$", "")
					local itemPart = low:match("membawa:%s*([^→%-]+)") or low:match("carrying:%s*([^→%-]+)") or low:match("holding:%s*([^→%-]+)") or ""
					itemPart = cleanDishName(itemPart)
					return {
						holding = true,
						rawText = clean,
						itemName = itemPart,
						targetDest = targetDest,
						isOnline = isOnline,
					}
				end
			end
		end
	end

	local char = LocalPlayer.Character
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") or child:IsA("Model") or child:IsA("BasePart") then
				local n = child.Name:lower()
				if hasAnyKeyword(n, {
					"mie", "noodle", "teh", "tea", "dish", "food", "drink",
					"tray", "dimsum", "pangsit", "siomay", "lumpia", "udang",
					"gadoan", "engklek", "bentengan", "congklak", "layangan", "gasing"
				}) then
					return {
						holding = true,
						rawText = child.Name,
						itemName = cleanDishName(n),
						targetDest = "",
						isOnline = false,
					}
				end
			end
		end
	end

	return { holding = false }
end

