end

-- ─── AUTO UPGRADE, MENU, ITEM & STAFF ─────────────────────────────
local itemCursor = 1
local upgradeCursor = 1
local dishCursor = 1
local staffCursor = 1

local function processAutoUpgrades()
	if cfg.autoUpgradeFacility and #CatalogUpgrades > 0 then
		local upgId = CatalogUpgrades[upgradeCursor]
		if upgId then
			invokeBuy("upgrade", upgId)
		end
		upgradeCursor = (upgradeCursor % #CatalogUpgrades) + 1
