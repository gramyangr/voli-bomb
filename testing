-- ─── MAIN LOOP (ROTASI MANDIRI) ─────────────────────────────────
local farmClock = 0
local farmStep = 1
local cleanTimer = 0
local questTimer = 0
local upgradeTimer = 0
local statsTimer = 0

local farmActions = {
	{ flag = "autoServeEnabled", fn = runAutoServeStep },
	{ flag = "autoTakeOrder", fn = runAutoTakeOrderStep },
	{ flag = "autoCookEnabled", fn = runAutoCookStep },
	{ flag = "autoDeliveryRack", fn = runAutoDeliveryStep },
}

RunService.Heartbeat:Connect(function(dt)
	if isActing and (os.clock() - actBusyStart) > 8.0 then
		isActing = false
	end

	if cfg.walkSpeedEnabled then
		local hum = getHumanoid()
		if hum and hum.WalkSpeed ~= cfg.walkSpeedValue then
			hum.WalkSpeed = cfg.walkSpeedValue
		end
	end

	farmClock = farmClock + dt
	if farmClock >= 0.45 and not isActing then
		farmClock = 0
		for i = 1, #farmActions do
			local idx = ((farmStep + i - 2) % #farmActions) + 1
			local act = farmActions[idx]
			if cfg[act.flag] then
				farmStep = (idx % #farmActions) + 1
				task.spawn(function()
					runExclusive(act.fn)
				end)
				break
			end
		end
	end

	if cfg.autoCleanEnabled then
		cleanTimer = cleanTimer + dt
		if cleanTimer >= 1.0 and not isActing then
			cleanTimer = 0
			task.spawn(function()
				runExclusive(runAutoCleanStep)
			end)
		end
	end

	if cfg.autoQuestEnabled then
		questTimer = questTimer + dt
		if questTimer >= 6.0 then
			questTimer = 0
			task.spawn(function()
				pcall(processAutoQuest)
			end)
		end
	end

	if cfg.autoUpgradeFacility or cfg.autoUnlockDish or cfg.autoBuyItems or cfg.autoBuyStaff then
		upgradeTimer = upgradeTimer + dt
		if upgradeTimer >= 0.8 then
			upgradeTimer = 0
			task.spawn(function()
				pcall(processAutoUpgrades)
			end)
		end
	end

	statsTimer = statsTimer + dt
	if statsTimer >= 1.0 then
		statsTimer = 0
		pcall(function()
			ParaStats:SetContent(string.format(
				"Pesanan Diantar: %d\nMeja Dibersihkan: %d\nQuest Diklaim: %d",
				statsServed,
				statsCleaned,
				statsQuests
			))
		end)
	end
end)

