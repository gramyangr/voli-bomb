ExecuteScriptEntry = function(entry)
    if isLaunching or closing then
        return
    end
    if type(entry.Url) ~= "string" or not entry.Url:match("^https?://") then
        SetStatus("warn", "Script URL for " .. tostring(entry.Name) .. " is not set.")
        Notify("Not Ready", "No raw link is assigned for " .. tostring(entry.Name) .. " yet.", "Warn", 3.5)
        return
    end

    isLaunching = true
    SetStatus("loading", "Preparing " .. tostring(entry.Name) .. "...")

    if isUserPanelOpen then
        isUserPanelOpen = false
        ClosePanelTweens(0.24)
        task.wait(0.3)
        UpdateScale(true)
    end

    Success.GameName.Text = tostring(entry.Name)
    Success.PlaceId.Text = tostring(entry.PlaceId)
    Success.SourceUrl.Text = tostring(entry.Url)
    Success.Subtitle.Text = "Loading script for " .. tostring(entry.Name) .. "."

    successActive = true
    Success.Pulse = false
    Success.Progress.Size = UDim2.fromScale(1, 1)
    Success.Countdown.Text = tostring(Config.SuccessDelay) .. "s"
    Success.HaloScale.Scale = 0.4
    for _, bar in ipairs(Success.CheckBars) do
        bar.Frame.Visible = false
    end
    Success.Frame.Visible = true

    ShowSnapshot(Success.BaseSnapshot, 0.35, Enum.EasingStyle.Quad)
    task.delay(0.4, function()
        if Success.Frame.Visible then
            for _, group in ipairs(UI.ContentGroups) do
                group.Visible = false
            end
        end
    end)

    task.spawn(function()
        task.wait(0.1)
        if closing then
            return
        end
        ShowSnapshot(Success.HaloSnapshot, 0.3)
        PlayTween(Success.HaloScale, 0.5, {Scale = 1}, Enum.EasingStyle.Back)
        task.wait(0.3)
        if closing then
            return
        end
        DrawCheckBar(Success.CheckBars[1], 0.14)
        task.wait(0.14)
        DrawCheckBar(Success.CheckBars[2], 0.22)
        task.wait(0.18)
        if closing then
            return
        end
        Success.Pulse = true
        BurstRing(Success.Frame, Success.Center, Colors.Gold)
        task.delay(0.12, function()
            if not closing then
                BurstRing(Success.Frame, Success.Center, Colors.Silver)
            end
        end)
        EmitParticles(Success.Frame, Success.Center, 18)
    end)

    RevealGroup(Success.Title, Success.TitleSnapshot, 0.3, 0, 8)
    RevealGroup(Success.Subtitle, Success.SubtitleSnapshot, 0.36, 0, 8)
    RevealGroup(Success.Card, Success.CardSnapshot, 0.42, Success.Stacked and 12 or 0, Success.Stacked and 0 or 12)
    for index, row in ipairs(Success.Rows) do
        RevealGroup(row, Success.RowSnapshots[index], 0.5 + index * 0.05, Success.Stacked and 0 or 10, Success.Stacked and 6 or 0, 0.35)
    end
    RevealGroup(Success.Footer, Success.FooterSnapshot, 0.55, 0, 8)

    task.delay(0.6, function()
        if not closing then
            PlayTween(Success.Progress, Config.SuccessDelay - 0.3, {Size = UDim2.fromScale(0, 1)}, Enum.EasingStyle.Linear)
        end
    end)

    task.spawn(function()
        for remaining = Config.SuccessDelay, 1, -1 do
            if closing or not Success.Countdown.Parent then
                return
            end
            Success.Countdown.Text = tostring(remaining) .. "s"
            task.wait(1)
        end
    end)

    task.wait(Config.SuccessDelay + 0.3)
    MorphAndRun(entry)
end

local function CheckAutoLoad()
    if not Config.AutoLoadMatchingGame then
        return
    end
    for _, entry in ipairs(ScriptList) do
        if tonumber(entry.PlaceId) == CurrentPlaceId and type(entry.Url) == "string" and entry.Url:match("^https?://") then
            task.wait(0.45)
            if not closing and not isLaunching then
                ExecuteScriptEntry(entry)
            end
            return
        end
    end
end

