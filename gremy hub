local function RunRawUrl(url)
    local ok, err = pcall(function()
        local rawCode = game:HttpGet(url)
        if type(rawCode) ~= "string" or rawCode:gsub("%s", "") == "" then
            error("Empty script response", 0)
        end
        local fn, compileErr = verifiedLoadstring(rawCode, "@" .. tostring(url))
        if type(fn) ~= "function" then
            error(tostring(compileErr or "Failed to compile script"), 0)
        end
        fn()
    end)
    return ok, err
end

