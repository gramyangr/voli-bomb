        UI.StatusText.Position = UDim2.fromOffset(UI.StatusTextX, 5)
        PlayTween(UI.StatusText, 0.25, {TextTransparency = 0, Position = UDim2.fromOffset(UI.StatusTextX, 0)}, Enum.EasingStyle.Quint)
