            Typeface = "Label",
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 3,
            Parent = item
        })

        Connect(item.MouseEnter, function()
            if isLaunching then
                return
            end
            PlayTween(item, 0.18, {BackgroundColor3 = Colors.ElevatedBG})
            PlayTween(itemStroke, 0.18, {Color = hasUrl and Colors.Gold or Colors.Warn})
            PlayTween(itemScale, 0.18, {Scale = 1.015})
            titleLabel.TextColor3 = Colors.GoldSoft
        end)

        Connect(item.MouseLeave, function()
            if isLaunching then
                return
            end
            PlayTween(item, 0.18, {BackgroundColor3 = isMatch and Colors.ElevatedBG or Colors.SecondaryBG})
            PlayTween(itemStroke, 0.18, {Color = isMatch and Colors.Gold or Colors.Stroke, Transparency = isMatch and 0.15 or 0})
            PlayTween(itemScale, 0.18, {Scale = 1})
            titleLabel.TextColor3 = Colors.TextPrimary
        end)

        Connect(item.MouseButton1Down, function()
            PlayTween(itemScale, 0.08, {Scale = 0.98}, Enum.EasingStyle.Quad)
        end)

        Connect(item.MouseButton1Up, function()
            PlayTween(itemScale, 0.18, {Scale = 1}, Enum.EasingStyle.Back)
        end)

        Connect(item.MouseButton1Click, function()
            if not IsReady() or isLaunching then
                return
            end
            if not UseCooldown("script_" .. tostring(index), 0.7) then
                return
            end
            ExecuteScriptEntry(entry)
        end)
    end
end

